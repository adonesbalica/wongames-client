exports[`<Highlight /> should render align left 1`] = `
.c0 {
  background-image: url(/img/read-dead-img.jpeg);
  background-position: center center;
  background-size: cover;
  position: relative;
  height: 23rem;
  display: grid;
  grid-template-areas: 'content floatImage';
  grid-template-columns: 2fr 1.3fr;
}

.c0::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
}

.c0 .c3 {
  text-align: left;
}

.c0 .c1 {
  justify-self: end;
}

.c2 {
  grid-area: floatImage;
  z-index: 10;
  max-height: 23rem;
  max-width: 100%;
  align-self: end;
}

.c4 {
  grid-area: content;
  z-index: 10;
  padding: 1.6rem;
}

.c5 {
  font-size: 1.8rem;
  font-weight: 600;
  color: #FAFAFA;
}

.c6 {
  font-size: 1.4rem;
  font-weight: 300;
  color: #FAFAFA;
  margin-bottom: 3.2rem;
}

.c7 {
  background: linear-gradient(180deg, #ff5f5f 0%, #f062c0 50%);
  color: #FAFAFA;
  border: 0;
  border-radius: 0.4rem;
  padding: 0.8rem;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 4rem;
  font-size: 1.4rem;
  padding: 0.8rem 3.2rem;
}

.c7:hover {
  background: linear-gradient(180deg, #e35565 0%, #d958a6 50%);
}

@media (min-width: 768px) {
  .c0 {
    height: 32rem;
  }
}

@media (min-width: 768px) {
  .c2 {
    max-height: 32rem;
  }
}

@media (min-width: 768px) {
  .c4 {
    align-self: end;
    padding: 4.0rem;
  }
}

@media (min-width: 768px) {
  .c5 {
    font-size: 2.8rem;
  }
}

@media (min-width: 768px) {
  .c6 {
    font-size: 1.8rem;
  }
}

<section
  alignment="left"
  backgroundimage="/img/read-dead-img.jpeg"
  class="c0"
>
